<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:elevation="2dp"
    android:layout_marginBottom="12dp"
    android:descendantFocusability="blocksDescendants">

    <!-- Header Row: Title, Date, & Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Goa Trip"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212529" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11 Oct 2026"
            android:textSize="12sp"
            android:textColor="#6C757D"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnDeleteTrip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#DC3545"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:contentDescription="Delete Trip" />
    </LinearLayout>

    <!-- Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F8F9FA"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvHistoryTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: ₹0.00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0D6EFD" />

        <TextView
            android:id="@+id/tvHistoryPerPerson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0.00 / person"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#198754" />
    </LinearLayout>

    <!-- Settlements Summary -->
    <TextView
        android:id="@+id/tvHistorySettlements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settlement details..."
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:textColor="#495057" />

</LinearLayout>