<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:layout_marginBottom="4dp">

    <!-- Row Index: 1., 2., etc. -->
    <TextView
        android:id="@+id/tvPersonIndex"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:text="1." />

    <!-- Column 1: Editable Person Name -->
    <EditText
        android:id="@+id/etPersonName"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:hint="Name..."
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Column 2 (Scenario 1): Active/Not Checkbox -->
    <CheckBox
        android:id="@+id/cbPersonActive"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:checked="true"
        android:layout_marginStart="4dp" />

    <!-- Column 2 (Scenario 2): Consumed / Used Amount EditText -->
    <EditText
        android:id="@+id/etPersonConsumed"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_input"
        android:hint="0"
        android:gravity="end|center_vertical"
        android:inputType="numberDecimal"
        android:paddingHorizontal="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginStart="4dp"
        android:visibility="gone" />

    <!-- Column 3: Paid Amount EditText -->
    <EditText
        android:id="@+id/etPersonPaid"
        android:layout_width="84dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_input"
        android:hint="0"
        android:gravity="end|center_vertical"
        android:inputType="numberDecimal"
        android:paddingHorizontal="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Column 4: Delete Person Row -->
    <ImageButton
        android:id="@+id/btnDeletePerson"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#8E8E93"
        android:contentDescription="Remove Person" />
</LinearLayout>