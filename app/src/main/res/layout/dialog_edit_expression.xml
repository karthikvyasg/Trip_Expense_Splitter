<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Expenses for Member"
        android:textColor="#212529"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="View full expression, add or edit amounts:"
        android:textColor="#6C757D"
        android:textSize="13sp" />

    <!-- Full Multi-line Expression Editor -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Full Expression (e.g. 50+100-25)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogEtFullExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789.+- "
            android:gravity="top|start"
            android:inputType="textVisiblePassword|textMultiLine"
            android:minLines="3"
            android:textColor="#212529"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Quick Operator Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogBtnAddPlus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Add"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/dialogBtnAddMinus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="− Subtract"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Live Subtotal -->
        <TextView
            android:id="@+id/dialogTvLiveSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: ₹0.00"
            android:textColor="#0D6EFD"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogBtnEditCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#6C757D" />

        <Button
            android:id="@+id/dialogBtnEditDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0D6EFD"
            android:text="Save &amp; Apply"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>