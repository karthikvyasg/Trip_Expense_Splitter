<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TripExpenseSplitter" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>
    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color when app opens -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>

        <!-- Center icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- The theme the app switches to after splash completes -->
        <item name="postSplashScreenTheme">@style/Theme.TripExpenseSplitter</item>
    </style>
</resources>