<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="10dp"
    app:strokeColor="#28A745"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:paddingHorizontal="4dp">

        <!-- Scenario 1 -->
        <LinearLayout
            android:id="@+id/itemScenario1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <View
                android:id="@+id/dotScenario1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_green"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scenario 1: Split by Who Joined &amp; Who Paid How Much"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F4F9"
            android:layout_marginHorizontal="8dp" />

        <!-- Scenario 2 -->
        <LinearLayout
            android:id="@+id/itemScenario2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <View
                android:id="@+id/dotScenario2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_green"
                android:visibility="invisible"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scenario 2: Pay by Who Consumed How Much"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>