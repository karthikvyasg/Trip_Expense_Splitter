<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Place / Activity Expense"
            android:textColor="#212529"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Activity / Place Title -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Place / Activity (e.g., Resort, Go-Karting)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="#212529" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Amount Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Total Amount (₹)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.+- "
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textColor="#212529" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Who Paid Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Who paid the bill?"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spPaidBy"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input" />

        <!-- Participant Checkboxes Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Who took part in this expense?"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uncheck anyone who skipped this place."
            android:textColor="#6C757D"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layoutParticipantCheckboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelItem"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#6C757D" />

            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0D6EFD"
                android:text="Add Expense"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>