<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Editable Activity Name & Delete Card Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etActivityTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Expense Activity 1 (tap to rename)"
                android:inputType="textCapWords"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDeleteActivityCard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#DC3545"
                android:contentDescription="Delete Activity" />
        </LinearLayout>

        <!-- Column Headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F4F9"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:paddingHorizontal="6dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Person"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Active"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Paid (₹)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <View
                android:layout_width="34dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Dynamic Container for Person Rows -->
        <LinearLayout
            android:id="@+id/layoutPersonRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Empty Tutorial Prompt -->
        <TextView
            android:id="@+id/tvEmptyPersonHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="No persons added yet.\nTap '+ Add Person' below to start this table."
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <!-- + Add Person to Group -->
        <Button
            android:id="@+id/btnAddPersonRow"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Add Person"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- Card Footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActivitySummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 active"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActivityCardTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Total: ₹0.00"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>